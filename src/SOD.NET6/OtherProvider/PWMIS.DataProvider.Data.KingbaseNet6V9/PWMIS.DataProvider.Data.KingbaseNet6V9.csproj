<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>PWMIS.SOD.Kingbase.Provider.Net6V9</PackageId>
    <AssemblyName>PWMIS.KingbaseClient.Net6V9</AssemblyName>
    <Authors>深蓝医生</Authors>	  
	<Description>SOD框架支持.NET 6以及之后的版本的人大金仓数据(支持V9版本)提供程序</Description>
	<Copyright>PWMIS.COM</Copyright>
	<Version>6.0.1</Version>
	<Company>PWMIS（程序员蜜糍）</Company>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SOD框架支持.NET 6以及之后的版本的人大金仓数据提供程序</Title>
    <PackageProjectUrl>https://github.com/znlgis/sod</PackageProjectUrl>
    <RepositoryUrl>https://github.com/znlgis/sod</RepositoryUrl>
    <PackageTags>SOD;SqlMap;ORM;DataForms;Kingbase</PackageTags>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>国产化支持.md</PackageReadmeFile>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageReleaseNotes>使用官方指定的驱动程序封装，用于访问金仓V9版本的数据库或者V8某些定制版本的数据库。
支持设置数据库兼容模式。</PackageReleaseNotes>	  
	  
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\国产化支持.md" Link="国产化支持.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kdbndp_V9" Version="6.0.5.422" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lib\PWMIS.SOD.Core\PWMIS.SOD.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource.Designer.cs">
      <DependentUpon>Resource.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
